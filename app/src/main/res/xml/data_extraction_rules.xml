<?xml version="1.0" encoding="utf-8"?><!--
    Backup / device-transfer rules for API 31+.

    Session tokens are excluded from both channels. See backup_rules.xml for the reasoning: the
    encryption key lives in the Android Keystore and is not part of the backup, so transferring
    the encrypted prefs would carry a bearer credential's ciphertext off-device without ever being
    usable on the other side.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mipelu_secure_prefs.xml" />
        <exclude domain="external" path="photos" />
        <exclude domain="database" path="mipelu.db" />
        <exclude domain="database" path="mipelu.db-journal" />
        <exclude domain="database" path="mipelu.db-shm" />
        <exclude domain="database" path="mipelu.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mipelu_secure_prefs.xml" />
        <exclude domain="external" path="photos" />
        <!-- Room IS transferred: the professional keeps her clients on a new phone. Tokens are
             not (keystore key doesn't travel), so she signs in again and Room already has data. -->
    </device-transfer>
</data-extraction-rules>
